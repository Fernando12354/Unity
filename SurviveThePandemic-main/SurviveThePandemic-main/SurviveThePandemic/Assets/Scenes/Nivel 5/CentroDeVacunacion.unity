  messageText: {fileID: 653231445}
  messageImage: {fileID: 1464724587}
  messages:
  - message: Genial, estar vacunado es lo maximo, debo llevarle la vacuna a mi Tio
      para que se sienta mejor
    image: {fileID: 21300000, guid: ebdc856ac09d29d4bb0fe4788ccfbd25, type: 3}
    displayDuration: 5
    delayBeforeShowing: 2
  - message: Levate una vacuna Alex, y cuidate mucho.
    image: {fileID: 21300000, guid: 41cf3a7f1ee87ae46b949cdb1c1e7317, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  - message: Claro que si.
    image: {fileID: 21300000, guid: 41cf3a7f1ee87ae46b949cdb1c1e7317, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  - message: Sal por la puerta para dirigirte con tu Tio.
    image: {fileID: 21300000, guid: 97cbeb1343ce688478002ad59f3ce02b, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
