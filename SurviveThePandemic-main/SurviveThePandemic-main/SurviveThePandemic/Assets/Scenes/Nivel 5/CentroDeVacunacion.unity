  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e4a056fe4dc0794f848ceb25fc33ea5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogText: {fileID: 1262076163}
  characterImage: {fileID: 643389836}
  dialogBox: {fileID: 876252209}
  characterImages:
  - {fileID: 21300000, guid: 41cf3a7f1ee87ae46b949cdb1c1e7317, type: 3}
  - {fileID: 21300000, guid: ebdc856ac09d29d4bb0fe4788ccfbd25, type: 3}
  - {fileID: 21300000, guid: 41cf3a7f1ee87ae46b949cdb1c1e7317, type: 3}
  - {fileID: 21300000, guid: ebdc856ac09d29d4bb0fe4788ccfbd25, type: 3}
  - {fileID: 21300000, guid: 41cf3a7f1ee87ae46b949cdb1c1e7317, type: 3}
  - {fileID: 21300000, guid: ebdc856ac09d29d4bb0fe4788ccfbd25, type: 3}
  - {fileID: 21300000, guid: 41cf3a7f1ee87ae46b949cdb1c1e7317, type: 3}
  - {fileID: 21300000, guid: ebdc856ac09d29d4bb0fe4788ccfbd25, type: 3}
  - {fileID: 21300000, guid: 41cf3a7f1ee87ae46b949cdb1c1e7317, type: 3}
  dialogTexts:
  - "\xA1Hola, Alex! Qu\xE9 alegr\xEDa verte aqu\xED. Hoy es un d\xEDa importante
    porque vas a recibir tu vacuna contra el COVID-19. \xBFEst\xE1s listo?"
  - "\xA1S\xED! Me dijeron que la vacuna me va a ayudar a estar protegido. \xBFMe
    puedes explicar c\xF3mo funciona?"
  - "Claro, Alex. La vacuna le ense\xF1a a tu cuerpo c\xF3mo defenderse del virus
    del COVID-19. Es como darle a tus defensas un entrenamiento especial, para que
    sepan qu\xE9 hacer si llegaran a encontrar el virus de verdad."
  - "\xA1Eso suena genial! Entonces, \xBFno me va a hacer da\xF1o?"
  - "No, no te preocupes. La vacuna es segura y solo contiene una peque\xF1a parte
    del virus, algo que no puede hacerte da\xF1o, pero que ayuda a tu cuerpo a reconocerlo.
    Puede que despu\xE9s sientas un poquito de dolor en el brazo o un poco de cansancio,
    pero eso es normal Significa que tu cuerpo est\xE1 trabajando para protegerte."
  - "\xBFY c\xF3mo me la van a poner?"
  - "Te pondremos una inyecci\xF3n en el brazo. Te prometemos que ser\xE1 r\xE1pido
    y solo sentir\xE1s un peque\xF1o pinchazo, estas listo?"
  - Si, Estoy Listo!!
  - Ok, Comenzare!!
