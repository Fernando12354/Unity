--- !u!114 &1468623931
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1468623930}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76cbb0967ddd2ec418d4d11839e096e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messageText: {fileID: 823719955}
  messageImage: {fileID: 1253337840}
  messages:
  - message: "Gracias por jugar con nosotros. \xA1Esperamos que hayas disfrutado
      la aventura!"
    image: {fileID: 21300000, guid: ebdc856ac09d29d4bb0fe4788ccfbd25, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  - message: "Recuerda que cuidarse es una responsabilidad de todos. La salud es
      lo m\xE1s importante."
    image: {fileID: 21300000, guid: 4e6f09a076d2ffc4e8cdb7247038a951, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  - message: "En tiempos de pandemia, protegerse es proteger tambi\xE9n a los dem\xE1s."
    image: {fileID: 21300000, guid: ff8b936849d116b4c9136f81b6de1121, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  - message: "L\xE1vate las manos con frecuencia, usa mascarilla y mant\xE9n la distancia.
      \xA1Peque\xF1os actos hacen una gran diferencia!"
    image: {fileID: 21300000, guid: 1eb9d72f4fa22094b8a93cbfbee452c8, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  - message: "Juntos, podemos superar cualquier desaf\xEDo. \xA1Cuida de ti y de
      quienes te rodean!"
    image: {fileID: 21300000, guid: 08dd867974b3928448c123932d8643dd, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  - message: "Gracias por tu tiempo y esfuerzo en el juego. \xA1Sigue cuid\xE1ndote
      siempre!"
    image: {fileID: 21300000, guid: ebdc856ac09d29d4bb0fe4788ccfbd25, type: 3}
    displayDuration: 5
    delayBeforeShowing: 1
  endCanvas: {fileID: 824322874}
  continueButton: {fileID: 1329366525}
  exitButton: {fileID: 1966326028}
  nextSceneName: Menu Principal
