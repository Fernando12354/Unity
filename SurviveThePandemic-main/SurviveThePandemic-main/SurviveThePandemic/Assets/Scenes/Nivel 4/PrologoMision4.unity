  m_Script: {fileID: 11500000, guid: c9b3af32e575a0a419484ed525120162, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  callAnswer: 0
  callSound: 0
  Notificacion: {fileID: 405564588}
  AnimateNotification: {fileID: 405564589}
  txtNotificacion: {fileID: 1002919891}
  textoNotificacion: Presiona X para contestar
  Phone: {fileID: 1349114160}
  vozCaller: {fileID: 8300000, guid: 8cd33c8b09ce0bd4093c662507659450, type: 3}
  vozAnswer: {fileID: 8300000, guid: b0d038d69d43a7a46a6a2f51ace8e35b, type: 3}
  interfaceLlamadas: {fileID: 1537820206}
  AnimateCall: {fileID: 1537820209}
  contenedorTexto: {fileID: 1394820026}
  llamadas:
  - caller: "Mam\xE1"
    answer: Alex
    dialogos:
    - talker: Alex
      text: "Hola mam\xE1, ya escuchaste la noticia de la vacuna??"
    - talker: "Mam\xE1"
      text: "S\xED, Alex, qu\xE9 emoci\xF3n, justamente por eso te hablo. \xA1Por
        fin podremos volver a nuestra vida cotidiana!!!\_"
    - talker: Alex
      text: "Tenemos que contarle esta noticia a mi t\xEDo, \xA1no puede perd\xE9rsela!"
    - talker: "Mam\xE1"
      text: "Oh, cierto, tu t\xEDo...... Alex tu t\xEDo me coment\xF3 que empez\xF3
        a sentirse muy mal hace unos d\xEDas. Alex, necesita que le lleves la comida
        que dej\xE9 en la mesa cuanto antes."
    - talker: Alex
      text: "Est\xE1 bien, est\xE1 bien..."
    - talker: "Mam\xE1"
      text: Alex cuidate mucho me da miedo que te contagies por ir con tu tio, pero
        no queda otra opcion
    - talker: Alex
      text: "No te preocupes, mam\xE1. Voy a seguir todas las medidas sanitarias
        que aprend\xED en la escuela para mantenerme seguro."
    - talker: "Mam\xE1"
      text: 'Cuidate Mucho Te amo.

'
  configuracion: {fileID: 11400000, guid: 524ff2cfe798ce346a2bf06151b4baed, type: 2}
